From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: KintTany port maintainer <patches@localhost>
Date: Fri, 20 Nov 2026 21:42:00 -0300
Subject: [PATCH] BladesTime: initialize a genuinely empty offline eShop rights manager

The main+0x172b50 Nintendo ec::ShopServiceAccessor::Initialize call
returns RES_FAIL in nxnative/hle_misc.c and enters the game's
nn::diag::AbortImpl at main+0x172c70. Both modes show the video and
then call svcBreak (Result 0x2a2) after creating the menu.

The game's ARM64 main imports 27 related nn::ec API methods and
initializes a ConsumableServiceItemManager at main+0x172bec/0x172c30.
Provide title-scoped successful startup and a no-owned-items manager,
without network access, fake purchases, rights, or grants. Other games
retain RES_FAIL from the existing ShopServiceAccessor initializer.

Upstream-Status: fork-only
Reason: Fix verified BladesTime post-intro Nintendo ec abort in SDK 9.4 (0x2a2)
Issue: joao9vegeto-stack/KintTany BladesTime iOS user log 2026-11-20
---
 dm/host/hle_misc.c | offline title-specific rights manager

diff --git a/dm/host/hle_misc.c b/dm/host/hle_misc.c
--- a/dm/host/hle_misc.c
+++ b/dm/host/hle_misc.c
@@ -98,19 +98,64 @@
 HLE_FORCE("_ZN2nn2ec33InitializeForShopServiceAccessorsEPvm", "shop service accessors' library init (ec service); offline, nothing to set up", Result, h_ec_InitSsa, void *mem, size_t n) { (void)mem; (void)n; return RES_OK; }
 HLE_FORCE("_ZN2nn2ec19ShopServiceAccessorC1Ev", "shop service accessor: no session (cut)", void, h_ec_SsaCtor, void *self) { (void)self; }
 HLE_FORCE("_ZN2nn2ec19ShopServiceAccessorD1Ev", "shop service accessor: no session to close (cut)", void, h_ec_SsaDtor, void *self) { (void)self; }
-HLE_FORCE("_ZN2nn2ec19ShopServiceAccessor10InitializeERKNS0_11ShopServiceE", "shop service accessor: the shop is unavailable offline (cut)", Result, h_ec_SsaInit, void *self, const void *svc) { (void)self; (void)svc; return RES_FAIL; }
+// Blades of Time calls the ShopServiceAccessor init unconditionally at boot
+// and asserts on its Result. Other titles keep the established unavailable
+// result; this offline path never reaches the network or grants purchases.
+static int ec_blades_time(void) { return !strcmp(DM_GAME_ID, "0100CFA00CC74000"); }
+HLE_FORCE("_ZN2nn2ec19ShopServiceAccessor10InitializeERKNS0_11ShopServiceE", "BladesTime offline ec accessor: empty entitlement state; all other titles unavailable", Result, h_ec_SsaInit, void *self, const void *svc) {
+    (void)self; (void)svc;
+    if (!ec_blades_time()) return RES_FAIL;
+    LOG("ec: BladesTime offline ShopServiceAccessor initialized (no shop, no purchases)");
+    return RES_OK;
+}
 HLE_FORCE("_ZN2nn2ec19ShopServiceAccessor7RequestEPNS1_13AsyncResponseERKNS_7account3UidENS0_11ShopService6MethodEPKcRKNS1_8PostDataENS_8TimeSpanE", "shop request: never sent (cut)",
           Result, h_ec_SsaRequest, void *self, void *resp, const void *uid, int method, const char *path, const void *post, int64_t timeout) {
     (void)self; (void)resp; (void)uid; (void)method; (void)path; (void)post; (void)timeout; return RES_FAIL;
 }
 HLE_FORCE("_ZN2nn2ec19ShopServiceAccessor13AsyncResponseC1Ev", "shop async response: no request (cut)", void, h_ec_ArCtor, void *self) { (void)self; }
 HLE_FORCE("_ZN2nn2ec19ShopServiceAccessor13AsyncResponseD1Ev", "shop async response: nothing to detach (cut)", void, h_ec_ArDtor, void *self) { (void)self; }
 HLE_FORCE("_ZN2nn2ec19ShopServiceAccessor13AsyncResponse7TryWaitEv", "shop async response: complete at once (cut)", unsigned, h_ec_ArTryWait, void *self) { (void)self; return 1; }
 HLE_FORCE("_ZN2nn2ec19ShopServiceAccessor13AsyncResponse7GetSizeEPm", "shop async response: no data (cut)", Result, h_ec_ArGetSize, void *self, size_t *n) { (void)self; if (n) *n = 0; return RES_FAIL; }
 HLE_FORCE("_ZN2nn2ec19ShopServiceAccessor13AsyncResponse3GetEPvm", "shop async response: no data (cut)", Result, h_ec_ArGet, void *self, void *buf, size_t n) { (void)self; (void)buf; (void)n; return RES_FAIL; }
 // DRAGON QUEST VII Reimagined (Unreal Engine 4.27) also imports these three: the library's finalize (its SDK version closes the ec session the init never opened) and two response calls
 HLE_FORCE("_ZN2nn2ec31FinalizeForShopServiceAccessorsEv", "shop service accessors' library finalize: nothing was set up", void, h_ec_FinSsa, void) {}
 HLE_FORCE("_ZN2nn2ec19ShopServiceAccessor13AsyncResponse6CancelEv", "shop async response: nothing to cancel (cut)", void, h_ec_ArCancel, void *self) { (void)self; }
 HLE_FORCE("_ZNK2nn2ec19ShopServiceAccessor13AsyncResponse12GetErrorCodeEv", "shop async response: no error code (cut)", uint64_t, h_ec_ArErr, const void *self) { (void)self; return 0; }
+// Blades of Time's ConsumableServiceItemManager normally asks the SDK ec
+// service for consumable entitlements, which does not exist on this host.
+// The game needs a *valid empty* offline manager, not RES_FAIL (fatal SDK
+// assertion), and never a fabricated purchase, token, or consumable item.
+HLE_FORCE("_ZN2nn2ec28ConsumableServiceItemManager10InitializeEPNS0_19ShopServiceAccessorERKNS_7account3UidEPvmPKvm", "BladesTime offline rights manager: empty imported rights", Result, h_ec_CsmInitData, void *self, void *accessor, const void *uid, void *work, size_t workSize, const void *saved, size_t savedSize) {
+    (void)self; (void)accessor; (void)uid; (void)work; (void)workSize; (void)saved; (void)savedSize;
+    if (!ec_blades_time()) return RES_FAIL;
+    LOG("ec: BladesTime offline consumable rights initialized with 0 owned items");
+    return RES_OK;
+}
+HLE_FORCE("_ZN2nn2ec28ConsumableServiceItemManager10InitializeEPNS0_19ShopServiceAccessorERKNS_7account3UidEPvm", "BladesTime offline rights manager: no serialized rights", Result, h_ec_CsmInit, void *self, void *accessor, const void *uid, void *work, size_t workSize) {
+    return h_ec_CsmInitData(self, accessor, uid, work, workSize, NULL, 0);
+}
+HLE_FORCE("_ZN2nn2ec28ConsumableServiceItemManager18IsRecoveryRequiredEv", "no offline consumable rights recovery", unsigned, h_ec_CsmRecoverNeeded, void *self) { (void)self; return 0; }
+HLE_FORCE("_ZN2nn2ec28ConsumableServiceItemManager15CanQueryNewDataEv", "offline: no store to query", unsigned, h_ec_CsmCanQuery, void *self) { (void)self; return 0; }
+HLE_FORCE("_ZN2nn2ec28ConsumableServiceItemManager21IsConsumptionRequiredEv", "offline: no consumables to redeem", unsigned, h_ec_CsmConsumeNeeded, void *self) { (void)self; return 0; }
+HLE_FORCE("_ZNK2nn2ec28ConsumableServiceItemManager24GetProvidableItemIdCountEv", "offline: zero purchased consumable item IDs", int, h_ec_CsmCount, void *self) { (void)self; return 0; }
+HLE_FORCE("_ZN2nn2ec28ConsumableServiceItemManager20GetProvidableItemIdsEPiPNS0_23ConsumableServiceItemIdEi", "offline: empty purchased consumable item ID list", Result, h_ec_CsmIds, void *self, int *count, void *ids, int capacity) {
+    (void)self; (void)ids; (void)capacity; if (count) *count = 0; return RES_OK;
+}
+HLE_FORCE("_ZNK2nn2ec28ConsumableServiceItemManager48GetRequiredBufferSizeToExportSerializedRightDataEv", "offline: no serialized right data", size_t, h_ec_CsmExportBytes, void *self) { (void)self; return 0; }
+HLE_FORCE("_ZNK2nn2ec28ConsumableServiceItemManager25ExportSerializedRightDataEPvm", "offline: no right data to export", Result, h_ec_CsmExport, void *self, void *out, size_t n) {
+    (void)self; (void)out; return n ? RES_FAIL : RES_OK;
+}
+HLE_FORCE("_ZN2nn2ec28ConsumableServiceItemManager19MarkServiceProvidedEPmRKNS0_23ConsumableServiceItemIdE", "offline: cannot redeem an unowned consumable", Result, h_ec_CsmProvided, void *self, size_t *count, const void *id) {
+    (void)self; (void)id; if (count) *count = 0; return RES_FAIL;
+}
+HLE_FORCE("_ZN2nn2ec28ConsumableServiceItemManager17SetupAsyncRequestEPNS0_28AsyncRecoverRightDataRequestE", "offline: cannot recover rights from eShop", Result, h_ec_CsmAsyncRecover, void *self, void *request) {
+    (void)self; (void)request; return RES_FAIL;
+}
+HLE_FORCE("_ZN2nn2ec28ConsumableServiceItemManager17SetupAsyncRequestEPNS0_34AsyncGetConsumableRightDataRequestE", "offline: cannot fetch eShop consumables", Result, h_ec_CsmAsyncGet, void *self, void *request) {
+    (void)self; (void)request; return RES_FAIL;
+}
+HLE_FORCE("_ZN2nn2ec28ConsumableServiceItemManager17SetupAsyncRequestEPNS0_28AsyncConsumeRightDataRequestE", "offline: cannot redeem consumables", Result, h_ec_CsmAsyncConsume, void *self, void *request) {
+    (void)self; (void)request; return RES_FAIL;
+}
 // The "add-on content lost" error screen is an applet too: logged only
 HLE_FORCE("_ZN2nn3aoc25ShowAddOnContentLostErrorEPKii", "add-on content lost error applet; the host only logs it", void, h_aoc_LostErr, const int *idx, int n) { DM_APPLET("error"); (void)idx; LOG("aoc::ShowAddOnContentLostError (%d entries) (cut)", n); }
-- 
