From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: KintTany port maintainer <patches@localhost>
Date: Fri, 20 Nov 2026 20:11:00 -0300
Subject: [PATCH] Vulkan: trace actual Dagor viewport and scissor sizes

Blades of Time displays a 1280x720-looking logo movie in the top-left
two-thirds of a 1920x1080 Vulkan swapchain while docked, and crashes
immediately after the intro movie on SquirrelFunction<> call failed.

Log the viewports and scissors selected by the game, bounded to the
first dozen queries plus any changed sizes. No drawing state is changed.
These records, captured on Mac with DM_VK_LOG, distinguish a 720p game
viewport from a Metal/UI drawable-size mismatch.

Upstream-Status: fork-only
Reason: Diagnose BladesTime logo cropping before touching iOS Metal scaling
Issue: joao9vegeto-stack/KintTany BladesTime iPhone log and screenshot 2026-11-20
---
 dm/gfx/vk/hle_vk.m | Vulkan viewport diagnostics

diff --git a/dm/gfx/vk/hle_vk.m b/dm/gfx/vk/hle_vk.m
--- a/dm/gfx/vk/hle_vk.m
+++ b/dm/gfx/vk/hle_vk.m
@@ -1486,11 +1486,31 @@
 VK(vkCmdBindIndexBuffer, void, VkCommandBuffer cb, VkBuffer b, VkDeviceSize o, VkIndexType t) { c_ib *c = rec(cb, C_IB, sizeof *c); c->b = b; c->o = o; c->t = t; }
 VK(vkCmdSetViewport, void, VkCommandBuffer cb, uint32_t first, uint32_t n, const VkViewport *v) {
     if (!n || first >= MAX_VIEWPORTS || n > MAX_VIEWPORTS - first) return;
+    // Keep tracing bounded: the game may set viewports thousands of times.
+    // A changed viewport is always logged, including 720p inside 1080p.
+    if (first == 0) {
+        static _Atomic int last_w, last_h;
+        static _Atomic unsigned shown;
+        int w = (int)v[0].width, h = (int)v[0].height;
+        int prev_w = atomic_exchange(&last_w, w), prev_h = atomic_exchange(&last_h, h);
+        if (w != prev_w || h != prev_h || atomic_fetch_add(&shown, 1) < 12)
+            VLOG("diag viewport: x=%.1f y=%.1f %.1fx%.1f (first=%u, count=%u)",
+                 v[0].x, v[0].y, v[0].width, v[0].height, first, n);
+    }
     c_vp *c = rec(cb, C_VP, sizeof *c + n * sizeof *v);
     c->first = first; c->n = n; memcpy(c->v, v, n * sizeof *v);
 }
 VK(vkCmdSetScissor, void, VkCommandBuffer cb, uint32_t first, uint32_t n, const VkRect2D *r) {
     if (!n || first >= MAX_VIEWPORTS || n > MAX_VIEWPORTS - first) return;
+    if (first == 0) {
+        static _Atomic int last_w, last_h;
+        static _Atomic unsigned shown;
+        int w = (int)r[0].extent.width, h = (int)r[0].extent.height;
+        int prev_w = atomic_exchange(&last_w, w), prev_h = atomic_exchange(&last_h, h);
+        if (w != prev_w || h != prev_h || atomic_fetch_add(&shown, 1) < 12)
+            VLOG("diag scissor: x=%d y=%d %ux%u (first=%u, count=%u)",
+                 r[0].offset.x, r[0].offset.y, r[0].extent.width, r[0].extent.height, first, n);
+    }
     c_sc *c = rec(cb, C_SC, sizeof *c + n * sizeof *r);
     c->first = first; c->n = n; memcpy(c->r, r, n * sizeof *r);
 }
