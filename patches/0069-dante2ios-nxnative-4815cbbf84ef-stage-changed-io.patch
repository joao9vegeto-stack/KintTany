---
 dm/ios/tests/test_xcode_workflow.py | 19 +++++++++++++++++--
 dm/ios/tools/stage_resources.sh     | 22 +++++++++++++++++++---
 2 files changed, 36 insertions(+), 5 deletions(-)

diff --git a/dm/ios/tests/test_xcode_workflow.py b/dm/ios/tests/test_xcode_workflow.py
index 521ade4..0e44671 100644
--- a/dm/ios/tests/test_xcode_workflow.py
+++ b/dm/ios/tests/test_xcode_workflow.py
@@ -274,8 +274,23 @@ class ImageStaging(unittest.TestCase):
                 result = subprocess.run(['bash', str(ios / 'tools/stage_resources.sh')], env=environment, capture_output=True, text=True)
                 self.assertEqual(result.returncode, 0, result.stderr)
             stage(packed)
-            self.assertEqual([p.name for p in (app / 'msl').iterdir()], ['b-abc.img']); self.assertEqual((app / 'msl/b-abc.img').read_bytes(), b'library file')
-            packed.write_bytes(b'newer'); stage(packed); self.assertEqual((app / 'msl/b-abc.img').read_bytes(), b'newer')
+            staged_romfs, staged_shaders = app / 'romfs.img', app / 'msl/b-abc.img'
+            self.assertEqual([p.name for p in (app / 'msl').iterdir()], ['b-abc.img'])
+            self.assertEqual(staged_shaders.read_bytes(), b'library file')
+            romfs_inode, shader_inode = staged_romfs.stat().st_ino, staged_shaders.stat().st_ino
+            stage(packed)
+            self.assertEqual(staged_romfs.stat().st_ino, romfs_inode)
+            self.assertEqual(staged_shaders.stat().st_ino, shader_inode)
+
+            previous = image.stat()
+            (source / 'marker').write_text('updated!')
+            romfs_image.pack(source, image)
+            self.assertEqual(image.stat().st_size, previous.st_size)
+            os.utime(image, ns=(previous.st_atime_ns, previous.st_mtime_ns + 2_000_000_000))
+            packed.write_bytes(b'newer')
+            stage(packed)
+            self.assertEqual(staged_romfs.read_bytes(), image.read_bytes())
+            self.assertEqual(staged_shaders.read_bytes(), b'newer')
             stage(folder); self.assertEqual([p.name for p in (app / 'msl').iterdir()], ['b-abc']); self.assertEqual((app / 'msl/b-abc/k_b.metallib').read_text(), 'loose')
             stage(packed); self.assertEqual([p.name for p in (app / 'msl').iterdir()], ['b-abc.img'])
 
diff --git a/dm/ios/tools/stage_resources.sh b/dm/ios/tools/stage_resources.sh
index 5414fa9..890872c 100644
--- a/dm/ios/tools/stage_resources.sh
+++ b/dm/ios/tools/stage_resources.sh
@@ -46,17 +46,33 @@ sync_dir() {   # source folder, destination folder
     if [ ! -d "$2" ] || [ -z "$(ls -A "$2" 2>/dev/null)" ]; then mkdir -p "$2"; /bin/cp -cRp -- "$1/." "$2/" || die "copy $1 to $2"
     else /usr/bin/rsync -a --delete -- "$1/" "$2/" || die "sync $1 to $2"; fi
 }
+sync_image() (   # source image, destination image
+    # Keep rsync's size and whole-second mtime check on rebuilds.
+    if [ -f "$2" ] && [ ! -L "$2" ]; then
+        source_stamp=$(/usr/bin/stat -L -f '%z:%m' -- "$1") || die "stat $1"
+        staged_stamp=$(/usr/bin/stat -f '%z:%m' -- "$2") || die "stat $2"
+        [ "$source_stamp" != "$staged_stamp" ] || return 0
+    fi
+    [ ! -d "$2" ] || die "Image destination is a directory: $2"
+    # Clone to a fresh path on the destination volume, then publish the complete image.
+    stage_dir=$(/usr/bin/mktemp -d "${2%/*}/.stage-image.XXXXXXXX") || die "create staging directory for $2"
+    trap '/bin/rm -rf -- "$stage_dir"' EXIT
+    trap 'exit 1' HUP INT TERM
+    /bin/cp -cp -- "$1" "$stage_dir/image" || die "copy $1 to $2"
+    /bin/mv -f -- "$stage_dir/image" "$2" || die "replace $2"
+)
 sync_libraries() {   # shader libraries (a folder, or an NVN game's one file: dm/tools/shader_lib.py), the app's msl folder for them, their name there
     if [ -f "$1" ]; then
-        rm -rf "${2:?}/$3"; mkdir -p "$2"
-        if [ -f "$2/$3.img" ]; then /usr/bin/rsync -a -- "$1" "$2/$3.img"; else /bin/cp -cp -- "$1" "$2/$3.img" || die "copy $1"; fi
+        mkdir -p "$2"
+        sync_image "$1" "$2/$3.img"
+        rm -rf "${2:?}/$3"
     else
         rm -f "${2:?}/$3.img"; sync_dir "$1" "$2/$3"
     fi
 }
 sync_romfs() {   # the RomFS (an image file or a folder), the app folder it goes in
     if [ -f "$1" ]; then
-        if [ -f "$2/romfs.img" ]; then /usr/bin/rsync -a -- "$1" "$2/romfs.img"; else /bin/cp -cp -- "$1" "$2/romfs.img" || die "copy $1"; fi
+        sync_image "$1" "$2/romfs.img"
         rm -rf "$2/romfs"; rm -f "$2/romfs.id"
     else
         sync_dir "$1" "$2/romfs"
