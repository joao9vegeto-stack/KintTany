+         guestFrame.resolve_valid &&
+         guestFrame.committed &&
+         guestFrame.nonblack_valid &&
+         !guestFrame.stale &&
+         !guestFrame.black_screen_guard;
+}
+
+bool HasFreshGuestFrame() {
+  return ShouldPresentGuestFrame();
+}
+
+bool IsGuestFrameStale() {
+  std::lock_guard lock(stateMutex);
+  return guestFrame.stale;
+}
+
+void NotifyGuestFrameRejected(const char* reason) {
+  std::lock_guard lock(stateMutex);
+  guestFrame.stale = true;
+  guestFrame.committed = false;
+  guestFrame.nonblack_valid = false;
+  guestFrame.black_screen_guard = true;
+  lastReject = reason ? reason : "XENOS_STALE_GUEST_FRAME: rejected";
+}
+
+void NotifyGuestFramePixels(uint32_t width, uint32_t height, const uint8_t* pixels, size_t bytes) {
+  if (pixels == nullptr || bytes == 0 || width == 0 || height == 0) {
+    NotifyGuestFrameRejected("XENOS_STALE_GUEST_FRAME: invalid_frame_pixels");
+    return;
+  }
+
+  std::lock_guard lock(stateMutex);
+  uint32_t count = 0;
+  const size_t stride = std::min<size_t>(bytes, size_t(width) * size_t(height) * 4u);
+  for (size_t i = 0; i + 3 < stride; i += 4) {
+    const uint8_t r = pixels[i + 0];
+    const uint8_t g = pixels[i + 1];
+    const uint8_t b = pixels[i + 2];
+    const uint8_t a = pixels[i + 3];
+    if (r || g || b || a) {
+      ++count;
+    }
+  }
+
+  guestFrame.nonblack_pixels = count;
+  guestFrame.nonblack_valid = count > 0;
+  guestFrame.width = width ? width : guestFrame.width;
+  guestFrame.height = height ? height : guestFrame.height;
+  if (count == 0) {
+    guestFrame.stale = true;
+    guestFrame.committed = false;
+    guestFrame.black_screen_guard = true;
+    lastReject = "XENOS_STALE_GUEST_FRAME: black_frame_after_resolve";
+  }
+}
