+    case 0x2318u:
+      guestFrame.copy_command = value & 0x1Fu;
+      isCopyPathActive = ((value & 0x00100000u) != 0u);
+      if ((value & 0x00100000u) == 0u) {
+        guestFrame.stale = true;
+        guestFrame.committed = false;
+        guestFrame.black_screen_guard = true;
+        lastReject = "XENOS_STALE_GUEST_FRAME: copy_control_without_commit";
+      }
+      break;
+    case 0x2319u:
+      guestFrame.address = value;
+      break;
+    case 0x231Au:
+      guestFrame.pitch = value;
+      break;
+    case 0x231Bu:
+      guestFrame.format = value;
+      break;
+    default:
+      break;
+  }
 }
