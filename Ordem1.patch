+void NotifyGuestResolve(uint32_t source_tile, uint32_t width, uint32_t height,
+                       uint32_t pitch, uint32_t copy_command, uint32_t resolve_status) {
+  std::lock_guard lock(stateMutex);
+  guestFrame.source_tile = source_tile;
+  guestFrame.width = width ? width : guestFrame.width;
+  guestFrame.height = height ? height : guestFrame.height;
+  guestFrame.pitch = pitch ? pitch : guestFrame.pitch;
+  guestFrame.copy_command = copy_command;
+  guestFrame.resolve_status = resolve_status;
+  guestFrame.has_color_source = true;
+  guestFrame.copied_to_swapchain = true;
+  guestFrame.resolve_valid = resolve_status != 0;
+  guestFrame.stale = false;
+  if (resolve_status == 0) {
+    guestFrame.committed = false;
+    guestFrame.black_screen_guard = true;
+    lastReject = "XENOS_STALE_GUEST_FRAME: resolve_status_zero";
+  }
+}
+
+void NotifyGuestFrameCommitted() {
+  std::lock_guard lock(stateMutex);
+  guestFrame.committed = true;
+  guestFrame.stale = false;
+  guestFrame.black_screen_guard = false;
+}
