# HookLink 4.0 iPhone defaults (upstream Resources/presets/iphone.env).
# Runtime settings in the launcher must remain user-selectable.
DM_OPMODE=0
DM_RT_COMP=auto
DM_FPS_HOLD=off
# DM_QOS_MAP, DM_DYNAMIC_RESOLUTION, DM_THERMAL_CAP and DM_FRAME_MODE
# are launcher settings, NOT hard-coded here. V4 buildEnv supplies defaults.
