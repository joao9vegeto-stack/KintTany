# HookLink: the settings baked into the iPhone app (tested on an iPhone 18 Pro Max)
DM_OPMODE=0
DM_QOS_MAP=1
# The game thread's real-time computation, measured each 120 frames (1.8.5: it was fixed at 12 ms, too little at 30 fps)
DM_RT_COMP=auto
DM_DYNAMIC_RESOLUTION=1
DM_FPS_HOLD=off
DM_THERMAL_CAP=0
