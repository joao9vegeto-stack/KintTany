diff --git a/src/kosmickrisp/meson.build b/src/kosmickrisp/meson.build
--- a/src/kosmickrisp/meson.build
+++ b/src/kosmickrisp/meson.build
@@ -16,4 +16,19 @@ executable(
     link_with: [libkk],
     link_args: ['-Wl,-undefined,dynamic_lookup'],
 )
+
+if with_platform_ios
+  # Compile the device smoke harness without linking a standalone executable.
+  # The app target owns the final static dependency closure and dispatch-table
+  # whole-archive semantics; a separate Meson link would bypass both.
+  static_library(
+    'kk-ios-smoke-objects',
+    files('kk_ios_smoke.m'),
+    include_directories : [inc_include, inc_src],
+    dependencies : [idep_vulkan_wsi_defines],
+    objc_args : ['-Wno-unguarded-availability-new'],
+    build_by_default : false,
+    install : false,
+  )
+endif
