diff --git a/meson.options b/meson.options
--- a/meson.options
+++ b/meson.options
@@ -12,7 +12,7 @@ option(
   type : 'array',
   value : ['auto'],
   choices : [
-    'auto', 'x11', 'wayland', 'haiku', 'android', 'windows', 'macos',
+    'auto', 'x11', 'wayland', 'haiku', 'android', 'windows', 'macos', 'ios',
   ],
   description : 'window systems to support. If this is set to `auto`, all ' +
                 'platforms applicable will be enabled.'
diff --git a/meson.build b/meson.build
--- a/meson.build
+++ b/meson.build
@@ -494,6 +494,12 @@ with_platform_wayland = _platforms.contains('wayland')
 with_platform_haiku = _platforms.contains('haiku')
 with_platform_windows = _platforms.contains('windows')
 with_platform_macos = _platforms.contains('macos')
+with_platform_ios = _platforms.contains('ios')
+
+if with_platform_ios and host_machine.system() != 'darwin'
+  error('The iOS platform requires a Darwin target toolchain')
+endif
+
 
 with_gfxstream_emulated_android = with_gfxstream_vk and with_platform_android and host_machine.system() == 'linux'
 if with_gfxstream_emulated_android
diff --git a/src/kosmickrisp/bridge/mtl_device.m b/src/kosmickrisp/bridge/mtl_device.m
--- a/src/kosmickrisp/bridge/mtl_device.m
+++ b/src/kosmickrisp/bridge/mtl_device.m
@@ -13,6 +13,7 @@
 #include <Metal/MTL4Counters.h>
 #include <Metal/MTLCaptureManager.h>
 #include <Metal/MTLDevice.h>
+#include <TargetConditionals.h>
 
 /* Device creation */
 mtl_device *
@@ -21,5 +22,11 @@ mtl_device_create()
    mtl_device *device = nil;
 
    @autoreleasepool {
+#if TARGET_OS_IOS
+      id<MTLDevice> system_device = MTLCreateSystemDefaultDevice();
+      if (system_device && [system_device supportsFamily:MTLGPUFamilyMetal4]) {
+         device = (mtl_device *)[system_device retain];
+      }
+#else
       NSArray<id<MTLDevice>> *devs = [MTLCopyAllDevices() autorelease];
       uint32_t device_count = [devs count];
@@ -28,8 +35,9 @@ mtl_device_create()
          if ([devs[i] supportsFamily:MTLGPUFamilyMetal4]) {
             device = (mtl_device *)[devs[i] retain];
             break;
          }
       }
+#endif
    }
 
    return device;
