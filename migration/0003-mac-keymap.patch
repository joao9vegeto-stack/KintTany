+	$(GUEST_FILE_ENV) DM_GUEST_FILE_CHUNK=64M $(B)/t_svc_memory
+	$(GUEST_FILE_ENV) DM_GUEST_FILE_CHUNK=64M $(B)/t_svc_memory_16k
+run: memory memory-dirty memory-profile memory-file
+
+# A native blocking notification wait must release the thread's guest core.
+$(B)/t_notify_sched: t_notify_sched.c t_condvar_stub.c ../hle_thread.c ../hle_oe.c ../hle.h ../dm.h $(GAME_H) | $(B)
+	$(CLANG) -O1 -g -Wall -Werror -Wno-unused-function -DDM_TEST_THREAD_ENTER -I.. $(GINC) -o $@ t_notify_sched.c t_condvar_stub.c
+.PHONY: notify-scheduler
+notify-scheduler: $(B)/t_notify_sched
+	$(B)/t_notify_sched
+	$(B)/t_notify_sched --all-peers
+run: notify-scheduler
+
+# Same-core handoff notification and timed recheck, using real thread SVCs.
+$(B)/t_handoff_wait: t_handoff_wait.c t_condvar_stub.c ../hle_thread.c ../dm.h $(GAME_H) | $(B)
+	$(CLANG) -O1 -g -Wall -Werror -Wno-unused-function -DDM_TEST_THREAD_ENTER -I.. $(GINC) -o $@ t_handoff_wait.c t_condvar_stub.c
+.PHONY: handoff-wait
+handoff-wait: $(B)/t_handoff_wait
+	$(B)/t_handoff_wait
+	$(B)/t_handoff_wait --all-peers
+run: handoff-wait
+
+# Sanitizer builds (../../sanitizers/sanitizers.mk): make asan runs every test of run under ASan and UBSan; make tsan-threads runs the tests that start threads under TSan
+# (t_audio_spsc, t_hid and t_svc_memory have their own TSan targets above: tsan, memory-tsan)
+include ../../sanitizers/sanitizers.mk
+.PHONY: asan tsan-threads tsan-threads-run
+asan:
+	@$(call san_fresh,$(B)/asan,$(ASAN_FLAGS))
+	$(ASAN_ENV) $(MAKE) B=$(B)/asan SAN="$(ASAN_FLAGS)" run
+TSAN_T = t_audio t_audio_stats t_audio_device t_thread_leak t_oe t_fs_commit_list t_fs_case t_save_sync t_condvar t_condvar_old t_preempt t_system_event t_notify_sched t_handoff_wait t_altstack t_sync_wait
+TSAN_T += t_net_eventfd t_net_loopback t_account
+tsan-threads:
+	@$(call san_fresh,$(B)/tsan,$(TSAN_FLAGS))
+	$(TSAN_ENV) $(MAKE) B=$(B)/tsan SAN="$(TSAN_FLAGS)" tsan-threads-run
+tsan-threads-run: $(addprefix $(B)/,$(TSAN_T))
+	$(B)/t_account
+	$(B)/t_net_eventfd
+	$(B)/t_net_loopback
+	$(B)/t_audio
+	$(B)/t_audio_stats
+	$(B)/t_audio_device
+	$(B)/t_thread_leak
+	$(B)/t_oe
+	TMPDIR="$(abspath $(B))" $(B)/t_fs_commit_list
+	TMPDIR="$(abspath $(B))" $(B)/t_fs_case
+	TMPDIR="$(abspath $(B))" $(B)/t_save_sync
+	$(B)/t_condvar
+	$(B)/t_condvar_old
+	$(B)/t_preempt
+	$(B)/t_preempt --all-peers
+	$(B)/t_system_event
+	$(B)/t_notify_sched
+	$(B)/t_notify_sched --all-peers
+	$(B)/t_handoff_wait
+	$(B)/t_handoff_wait --all-peers
+	$(B)/t_altstack
+	$(B)/t_sync_wait
+	DM_QOS_MAP=1 $(B)/t_notify_sched
+	DM_QOS_MAP=1 $(B)/t_notify_sched --all-peers
+$(B)/t_pad_hid: t_pad_hid.c ../pad_hid.h ../dm_input.h | $(B)
+	$(CLANG) -O1 -g -Wall -Werror -Wno-unused-function -fsanitize=address,undefined -I.. -o $@ t_pad_hid.c
+run: $(B)/t_pad_pro
+$(B)/t_pad_pro: t_pad_pro.c ../pad_pro.h ../dm_input.h | $(B)
+	$(CLANG) -O1 -g -Wall -Werror -Wno-unused-function -fsanitize=address,undefined -I.. -o $@ t_pad_pro.c
+$(B)/t_switch2: t_switch2.c ../switch2_proto.h ../dm_input.h | $(B)
+	$(CLANG) -O1 -g -Wall -Werror -Wno-unused-function -fsanitize=address,undefined -I.. -o $@ t_switch2.c
+
+# Line coverage (../../sanitizers/coverage.mk): make coverage builds every test of run into $(B)/cov with COV_FLAGS, runs them and writes $(B)/cov/coverage.lcov.
+# It measures, it does not test: make -i runs every test even after one fails (the plain run reports that), so the coverage of the others is kept.
+include ../../sanitizers/coverage.mk
+.PHONY: coverage
+coverage:
+	@$(call san_fresh,$(B)/cov,$(COV_FLAGS))
+	rm -rf $(B)/cov/prof
+	LLVM_PROFILE_FILE="$(call cov_profile,$(B)/cov)" $(MAKE) -i B=$(B)/cov SAN="$(COV_FLAGS)" run
+	@$(call cov_export,$(B)/cov)
diff --git a/dm/host/tests/t_input_map.c b/dm/host/tests/t_input_map.c
new file mode 100644
index 00000000..96736ad6
--- /dev/null
+++ b/dm/host/tests/t_input_map.c
@@ -0,0 +1,43 @@
+// The Mac front end's button assignments (input_map.h): the default key map, DM_KEYMAP moving and swapping functions, DM_PAD_MAP's swaps, and malformed entries left out
+#include "../input_map.h"
+
+static int checks, fails;
+#define CHECK(c, msg) do { checks++; if (!(c)) { fails++; fprintf(stderr, "FAIL: %s (line %d)\n", msg, __LINE__); } } while (0)
+
+int main(void) {
+    key_map k; key_map_default(&k);
+    CHECK(key_map_fn(&k, 38) == 0 && key_map_fn(&k, 40) == 1 && key_map_fn(&k, 32) == 2 && key_map_fn(&k, 34) == 3, "default: J K U I are A B X Y");
+    CHECK(key_map_fn(&k, 13) == IM_LUP && key_map_fn(&k, 0) == IM_LLEFT && key_map_fn(&k, 1) == IM_LDOWN && key_map_fn(&k, 2) == IM_LRIGHT, "default: W A S D are the left stick");
+    CHECK(key_map_fn(&k, 49) == IM_SHAKE && key_map_fn(&k, 36) == 10 && key_map_fn(&k, 125) == 15, "default: Space shakes, Return is +, down arrow is Down");
+    int right = 0; for (int c = 0; c < IM_KEYS; c++) if (k.fn[c] >= IM_RUP && k.fn[c] <= IM_RRIGHT) right++;
+    CHECK(right == 0, "default: the right stick is on no key");
+    CHECK(key_map_fn(&k, 200) == -1 && key_map_fn(&k, 50) == -1, "a key code past the table or without a function holds none");
+
+    CHECK(key_map_parse(&k, "A=40,B=38") == 0, "a swap parses");
+    CHECK(key_map_fn(&k, 40) == 0 && key_map_fn(&k, 38) == 1, "A=40,B=38 swaps A and B");
+    key_map_default(&k);
+    CHECK(key_map_parse(&k, "a=49") == 0 && key_map_fn(&k, 49) == 0 && key_map_fn(&k, 38) == -1, "names are case-insensitive; A leaves J, and Space leaves Shake");
+    int shake = 0; for (int c = 0; c < IM_KEYS; c++) if (k.fn[c] == IM_SHAKE) shake++;
+    CHECK(shake == 0, "the function a key held before is on no key");
+    CHECK(key_map_parse(&k, "RUp=126,RLeft=123,Up=none") == 0, "right stick on the arrows, Up on none");
+    CHECK(key_map_fn(&k, 126) == IM_RUP && key_map_fn(&k, 123) == IM_RLEFT, "the arrows hold the right stick");
+    int up = 0; for (int c = 0; c < IM_KEYS; c++) if (k.fn[c] == 13) up++;
+    CHECK(up == 0, "Up=none leaves Up on no key");
+    key_map_default(&k);
+    CHECK(key_map_parse(&k, "Q=1,ZL=abc,A=128,B=,=5,X=7") == 5, "five malformed entries are counted");
+    CHECK(key_map_fn(&k, 7) == 2 && key_map_fn(&k, 6) == 8 && key_map_fn(&k, 38) == 0, "the good entry applies, the malformed ones change nothing");
+    CHECK(key_map_parse(&k, "") == 0 && key_map_parse(&k, NULL) == 0 && key_map_parse(&k, "L=12,") == 0, "empty lists and a trailing comma are fine");
+
+    pad_map m; pad_map_default(&m);
+    CHECK(pad_map_is_default(&m) && pad_map_apply(&m, DM_BTN_A | DM_BTN_ZR | DM_BTN_SHAKE) == (DM_BTN_A | DM_BTN_ZR | DM_BTN_SHAKE), "default: every button sends itself, Shake passes");
+    CHECK(pad_map_parse(&m, "A=B,B=A") == 0 && !pad_map_is_default(&m), "a swap parses");
+    CHECK(pad_map_apply(&m, DM_BTN_A) == DM_BTN_B && pad_map_apply(&m, DM_BTN_B) == DM_BTN_A && pad_map_apply(&m, DM_BTN_A | DM_BTN_B) == (DM_BTN_A | DM_BTN_B), "A=B,B=A swaps them");
+    CHECK(pad_map_apply(&m, DM_BTN_X | DM_BTN_DOWN) == (DM_BTN_X | DM_BTN_DOWN), "buttons not named stay");
+    CHECK(pad_map_parse(&m, "ZL=L,minus=none") == 0, "two buttons on one, and none");
+    CHECK(pad_map_apply(&m, DM_BTN_ZL) == DM_BTN_L && pad_map_apply(&m, DM_BTN_L | DM_BTN_ZL) == DM_BTN_L && pad_map_apply(&m, DM_BTN_MINUS) == 0, "ZL sends L, Minus sends nothing");
+    pad_map_default(&m);
+    CHECK(pad_map_parse(&m, "A=LUp,LUp=A,Shake=B,Y=X") == 3 && m.to[3] == 2 && m.to[0] == 0, "sticks and Shake are no buttons here: left out; Y=X applies");
+
+    printf("input map: %d checks, %d failed\n", checks, fails);
+    return fails != 0;
+}
diff --git a/dm/host/tests/t_launcher_contract.c b/dm/host/tests/t_launcher_contract.c
new file mode 100644
index 00000000..136b4035
--- /dev/null
+++ b/dm/host/tests/t_launcher_contract.c
@@ -0,0 +1,35 @@
+/* The write half is ControlLayout.environment in frontend/Sources/NSPortBuilder/Controls.swift;
+   the read half is input_map.h. The launcher sends exactly these strings, so this checks the
+   contract between the two: a rename on either side, or a change of syntax, fails here rather
+   than at a player's keyboard. */
+#include "../input_map.h"
+static int checks, fails;
+#define CHECK(c, msg) do { checks++; if (!(c)) { fails++; fprintf(stderr, "FAIL: %s\n", msg); } } while (0)
+int main(void) {
+    key_map k; key_map_default(&k);
+    /* Settings: A moved onto K (40), B left on none — ControlsTests' first case */
+    CHECK(key_map_parse(&k, "A=40,B=none") == 0, "A=40,B=none parses");
+    CHECK(key_map_fn(&k, 40) == 0, "K now sends A");
+    int bfound = 0; for (int c = 0; c < IM_KEYS; c++) if (k.fn[c] == 1) bfound = 1;
+    CHECK(!bfound, "B is on no key");
+
+    pad_map m; pad_map_default(&m);
+    /* Settings: A and B swapped, Minus sends nothing */
+    CHECK(pad_map_parse(&m, "A=B,B=A,Minus=none") == 0, "A=B,B=A,Minus=none parses");
+    CHECK(pad_map_apply(&m, DM_BTN_A) == DM_BTN_B, "pad A sends B");
+    CHECK(pad_map_apply(&m, DM_BTN_B) == DM_BTN_A, "pad B sends A");
+    CHECK(pad_map_apply(&m, DM_BTN_MINUS) == 0, "Minus sends nothing");
+    CHECK(pad_map_apply(&m, DM_BTN_Y) == DM_BTN_Y, "untouched buttons stay");
+
+    /* the right stick on I, as the Controls sheet's own capture sets it */
+    key_map_default(&k);
+    CHECK(key_map_parse(&k, "RUp=34") == 0, "RUp=34 parses");
+    CHECK(key_map_fn(&k, 34) == IM_RUP, "I now sends RUp (and Y left I)");
+    int yfound = 0; for (int c = 0; c < IM_KEYS; c++) if (k.fn[c] == 3) yfound = 1;
+    CHECK(!yfound, "Y is on no key any more");
+    int rup = 0; for (int c = 0; c < IM_KEYS; c++) if (k.fn[c] == IM_RUP) rup = 1;
+    CHECK(rup, "RUp is on a key");
+
+    printf("launcher contract: %d checks, %d failed\n", checks, fails);
+    return fails != 0;
+}
diff --git a/docs/development.md b/docs/development.md
index ac101f0c..dcf85e0d 100644
--- a/docs/development.md
+++ b/docs/development.md
@@ -14,6 +14,8 @@ The README covers packing and playing. This page is for working on nxnative itse
 | iOS app | One unsigned IPA for iPhone and iPad. The rewritten code is embedded in the executable; the shader libraries, the RomFS and the game icon are inside the app. A settings screen comes before the game (`Launcher.swift`, drawn from `dm/launcher.json`, which `dm/games/settings.py` writes from `dm/games/settings.tsv`); the host's loading starts at app launch meanwhile, and the frame rate and render scale go into the frame step state when the game starts (`loader.c` `dm_fps_state_apply`) |
 | Known gaps | Conditional render is always drawn; [indirect-count multi-draws](reference/rendering.md#indirect-count-multi-draws) can wait for a GPU-written count when the records need conversion, cannot be GPU-masked, or exceed the mask table capacity; geometry shaders do not translate. TBDR optimizations are off by default (they don't understand bindless textures yet). No amiibo. On the Mac, Mario's menu and dialogue text render blank (fine on the iPhone) |
 
+On the Mac, `DM_KEYMAP=<name>=<key code>,…` puts a button, a stick direction (the right stick too, on no key by default) or `Shake` on another key, and `DM_PAD_MAP=<name>=<name>,…` changes what a controller's buttons send (`A=B,B=A` swaps them; `input_map.h`).
+
 ## Cheats
 
 How a Switch with Atmosphère runs cheats, and where this host differs, is in [Cheats on a Switch](reference/cheats.md).
