+#define DM_GAME_FPS_TARGET 0
+#endif
+#ifndef DM_GAME_FPS_HOLD
+#define DM_GAME_FPS_HOLD 1
+#endif
+#ifndef DM_GAME_PRESENT_SNAP
+#define DM_GAME_PRESENT_SNAP 0
+#endif
+#ifndef DM_GAME_PSO_MTL4
+#define DM_GAME_PSO_MTL4 0
+#endif
