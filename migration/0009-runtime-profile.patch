+	$(CLANG) -O1 -g -Wall -Werror -Wno-unused-function -DDM_TEST_THREAD_ENTER -I.. $(GINC) -o $@ t_handoff_wait.c t_condvar_stub.c
+.PHONY: handoff-wait
+handoff-wait: $(B)/t_handoff_wait
+	$(B)/t_handoff_wait
+	$(B)/t_handoff_wait --all-peers
+run: handoff-wait
+
+# Sanitizer builds (../../sanitizers/sanitizers.mk): make asan runs every test of run under ASan and UBSan; make tsan-threads runs the tests that start threads under TSan
+# (t_audio_spsc, t_hid and t_svc_memory have their own TSan targets above: tsan, memory-tsan)
+include ../../sanitizers/sanitizers.mk
+.PHONY: asan tsan-threads tsan-threads-run
+asan:
+	@$(call san_fresh,$(B)/asan,$(ASAN_FLAGS))
+	$(ASAN_ENV) $(MAKE) B=$(B)/asan SAN="$(ASAN_FLAGS)" run
+TSAN_T = t_audio t_audio_stats t_audio_device t_thread_leak t_oe t_fs_commit_list t_fs_case t_save_sync t_condvar t_condvar_old t_preempt t_system_event t_notify_sched t_handoff_wait t_altstack t_sync_wait
+TSAN_T += t_net_eventfd t_net_loopback t_account
+tsan-threads:
+	@$(call san_fresh,$(B)/tsan,$(TSAN_FLAGS))
+	$(TSAN_ENV) $(MAKE) B=$(B)/tsan SAN="$(TSAN_FLAGS)" tsan-threads-run
+tsan-threads-run: $(addprefix $(B)/,$(TSAN_T))
+	$(B)/t_account
+	$(B)/t_net_eventfd
+	$(B)/t_net_loopback
+	$(B)/t_audio
+	$(B)/t_audio_stats
+	$(B)/t_audio_device
+	$(B)/t_thread_leak
+	$(B)/t_oe
+	TMPDIR="$(abspath $(B))" $(B)/t_fs_commit_list
+	TMPDIR="$(abspath $(B))" $(B)/t_fs_case
+	TMPDIR="$(abspath $(B))" $(B)/t_save_sync
+	$(B)/t_condvar
+	$(B)/t_condvar_old
+	$(B)/t_preempt
+	$(B)/t_preempt --all-peers
+	$(B)/t_system_event
+	$(B)/t_notify_sched
+	$(B)/t_notify_sched --all-peers
+	$(B)/t_handoff_wait
+	$(B)/t_handoff_wait --all-peers
+	$(B)/t_altstack
+	$(B)/t_sync_wait
+	DM_QOS_MAP=1 $(B)/t_notify_sched
+	DM_QOS_MAP=1 $(B)/t_notify_sched --all-peers
+$(B)/t_pad_hid: t_pad_hid.c ../pad_hid.h ../dm_input.h | $(B)
+	$(CLANG) -O1 -g -Wall -Werror -Wno-unused-function -fsanitize=address,undefined -I.. -o $@ t_pad_hid.c
+run: $(B)/t_pad_pro
+$(B)/t_pad_pro: t_pad_pro.c ../pad_pro.h ../dm_input.h | $(B)
+	$(CLANG) -O1 -g -Wall -Werror -Wno-unused-function -fsanitize=address,undefined -I.. -o $@ t_pad_pro.c
+$(B)/t_switch2: t_switch2.c ../switch2_proto.h ../dm_input.h | $(B)
+	$(CLANG) -O1 -g -Wall -Werror -Wno-unused-function -fsanitize=address,undefined -I.. -o $@ t_switch2.c
+
+# Line coverage (../../sanitizers/coverage.mk): make coverage builds every test of run into $(B)/cov with COV_FLAGS, runs them and writes $(B)/cov/coverage.lcov.
+# It measures, it does not test: make -i runs every test even after one fails (the plain run reports that), so the coverage of the others is kept.
+include ../../sanitizers/coverage.mk
+.PHONY: coverage
+coverage:
+	@$(call san_fresh,$(B)/cov,$(COV_FLAGS))
+	rm -rf $(B)/cov/prof
+	LLVM_PROFILE_FILE="$(call cov_profile,$(B)/cov)" $(MAKE) -i B=$(B)/cov SAN="$(COV_FLAGS)" run
+	@$(call cov_export,$(B)/cov)
+# the runtime profile (hle_profile.c): a DM_PROFILE file, DM_PROF_* variables and the compiled fallback
+$(B)/t_profile_runtime: t_profile_runtime.c ../hle_profile.c ../hle_profile.h ../dm.h $(GAME_H) | $(B)
+	$(CLANG) -O1 -g -Wall -Werror -Wno-unused-function -I.. $(GINC) -o $@ t_profile_runtime.c ../hle_profile.c
+.PHONY: profile-runtime
+profile-runtime: $(B)/t_profile_runtime
+	TMPDIR="$(abspath $(B))" $(B)/t_profile_runtime
diff --git a/dm/host/tests/t_layout_runtime.c b/dm/host/tests/t_layout_runtime.c
new file mode 100644
index 00000000..20b210d4
--- /dev/null
+++ b/dm/host/tests/t_layout_runtime.c
@@ -0,0 +1,103 @@
+// Stage-2 feasibility check: one binary, several guest memory layouts chosen at run time from DM_PROFILE.
+// Each layout runs in its own process (mem_init is once per process, as in the host), so this test re-execs itself
+// with LAYOUT set, boots the production dispatcher (hle_svc.c mem_init via GetInfo), and prints what it built.
+// Build: clang -O1 -I.. -I../gen/<game> -o build/t_layout_runtime t_layout_runtime.c ../hle_svc.c ../hle_profile.c
+#include "../dm.h"
+#include "../hle_profile.h"
+#include <assert.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#include <errno.h>
+
+module_t g_mod[MAX_MOD];
+int g_nmod;
+struct dm_flags g_flag;
+void hlecount_svc(int num) { (void)num; }
+int svc_thread(int num, uint64_t *regs) { (void)num; (void)regs; return 0; }
+void dm_backtrace(uint64_t fp) { (void)fp; }
+void guest_clock_read_wait(void) {}
+uint64_t guest_ns(void) { return 0; }
+uint64_t dm_entropy64(void) { return 0; }
+int thr_limit_used(void) { return 0; }
+int dm_ue_heap_owns(uint64_t a, uint64_t n) { (void)a; (void)n; return 0; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+void dm_guest_write_prepare(void *addr, size_t size) { (void)addr; (void)size; }
+
+uint64_t svc_dispatch(int num, uint64_t *regs, uint64_t orig_addr);   // hle_svc.c
+static uint64_t info(int which) { uint64_t regs[31] = {0}; regs[1] = (uint64_t)which; svc_dispatch(0x29, regs, 0); return regs[1]; }   // GetInfo(out, id): id in x1, value out in x1
+
+typedef struct { const char *name, *profile; uint64_t reserve, alias, stack, pool, used, sysres; int limit; } case_t;
+static const case_t CASES[] = {
+    // Tears of the Kingdom: 5 GB, 2.375 GB alias
+    {"totk", "layout_totk.tsv", 0x140000000ull, 0x98000000ull, 0x10000000ull, 0xCD500000ull, 0x4000000ull, 0x2000000ull, 0},
+    // Animal Crossing: 4 GB, 256 MB alias, no system resource
+    {"acnh", "layout_acnh.tsv", 0x100000000ull, 0x10000000ull, 0x10000000ull, 0xCD500000ull, 0x7a00000ull, 0x0ull, 0},
+    // Super Mario Galaxy: 1 GB total (the smallest profile in the repository)
+    {"smg",  "layout_smg.tsv",  0x40000000ull, 0x10000000ull, 0x10000000ull, 0xCD500000ull, 0x4000000ull, 0ull, 1},
+    // Aegis Rim: alias 2.875 GB with the map limit on
+    {"13s",  "layout_13s.tsv",  0x140000000ull, 0x118000000ull, 0x10000000ull, 0x40000000ull, 0x4000000ull, 0x1000000ull, 1},
+};
+#define NCASES ((int)(sizeof CASES / sizeof CASES[0]))
+
+static int child(const case_t *c) {
+    char path[512]; snprintf(path, sizeof path, "%s/%s", getenv("LAYOUT_DIR") ?: ".", c->profile);
+    setenv("DM_PROFILE", path, 1);
+    const struct dm_profile *p = dm_profile();
+    fprintf(stderr, "[child] %s: profile %s reserve %#llx alias %#llx stack %#llx pool %#llx used %#llx sysres %#llx limit %d\n",
+            c->name, p->source, (unsigned long long)p->mem_reserve, (unsigned long long)p->mem_alias,
+            (unsigned long long)p->mem_stack, (unsigned long long)p->app_pool, (unsigned long long)p->mem_used,
+            (unsigned long long)p->sys_resource, p->mem_map_limit);
+    // what the host reports to the guest, built by the production dispatcher
+    uint64_t aslr = info(12), aslr_size = info(13), heap_addr = info(4), heap_size = info(5);
+    uint64_t alias_addr = info(2), alias_size = info(3), stack_addr = info(14), stack_size = info(15);
+    uint64_t total = info(6), used = info(7), sysres = info(16);
+    printf("%-6s reserve %#-12llx alias %#-12llx stack %#-12llx heap_region %#-12llx | got aslr %#llx+%#llx alias %#llx+%#llx stack %#llx+%#llx heap@%#llx total %#llx used %#llx sysres %#llx\n",
+           c->name, (unsigned long long)aslr_size, (unsigned long long)alias_size, (unsigned long long)stack_size,
+           (unsigned long long)heap_size, (unsigned long long)aslr, (unsigned long long)aslr_size,
+           (unsigned long long)alias_addr, (unsigned long long)alias_size, (unsigned long long)stack_addr,
+           (unsigned long long)stack_size, (unsigned long long)heap_addr, (unsigned long long)total,
+           (unsigned long long)used, (unsigned long long)sysres);
+    int ok = aslr_size == c->reserve && alias_size == c->alias && stack_size == c->stack && heap_size == c->reserve - 0x10000000ull - c->alias - c->stack
+             && alias_addr == aslr + 0x10000000ull && stack_addr == alias_addr + c->alias
+             && heap_addr == stack_addr + c->stack && total == c->pool && sysres == c->sysres;
+    if (used != c->used) { printf("  [RED] used memory %#llx, profile says %#llx\n", (unsigned long long)used, (unsigned long long)c->used); ok = 0; }
+    // SetHeapSize must succeed inside the runtime region
+    { uint64_t regs[31] = {0}; regs[1] = heap_size / 2; svc_dispatch(0x01, regs, 0); if (regs[0]) { printf("  [RED] SetHeapSize(%#llx) failed %#llx\n", (unsigned long long)(heap_size / 2), (unsigned long long)regs[0]); ok = 0; } }
+    // an explicit-profile mismatch must be visible, not silently ignored
+    printf("  %s\n", ok ? "OK" : "[RED] MISMATCH");
+    return ok ? 0 : 1;
+}
+
+int main(int argc, char **argv) {
+    if (argc > 1) {   // child mode: LAYOUT names the case
+        for (int i = 0; i < NCASES; i++) if (!strcmp(argv[1], CASES[i].name)) return child(&CASES[i]);
+        return 2;
+    }
+    // Write each case's profile where the child will find it (the profile loader takes a path in
+    // DM_PROFILE and reads game.tsv's key/value form). Generated here rather than committed: the
+    // values live in CASES above, and a fixture that can drift from them is a test that lies.
+    for (int i = 0; i < NCASES; i++) {
+        char path[256]; snprintf(path, sizeof path, "layout_%s.tsv", CASES[i].name);
+        FILE *f = fopen(path, "w");
+        if (!f) { printf("[RED] cannot write %s (errno %d)\n", path, errno); return 1; }
+        fprintf(f, "# generated by t_layout_runtime: the case table above is the source of truth\n");
+        fprintf(f, "name %s (runtime layout test)\n", CASES[i].name);
+        fprintf(f, "mem_reserve %#llx\n", (unsigned long long)CASES[i].reserve);
+        fprintf(f, "mem_alias %#llx\n", (unsigned long long)CASES[i].alias);
+        fprintf(f, "mem_stack %#llx\n", (unsigned long long)CASES[i].stack);
+        fprintf(f, "app_pool %#llx\n", (unsigned long long)CASES[i].pool);
+        fprintf(f, "mem_used %#llx\n", (unsigned long long)CASES[i].used);
+        fprintf(f, "sys_resource %#llx\n", (unsigned long long)CASES[i].sysres);
+        fprintf(f, "mem_map_limit %d\n", CASES[i].limit);
+        fclose(f);
+    }
+    int bad = 0;
+    for (int i = 0; i < NCASES; i++) {
+        pid_t pid = fork();
+        if (!pid) { execl(argv[0], argv[0], CASES[i].name, (char *)NULL); _exit(3); }
+        int st = 0; waitpid(pid, &st, 0);
+        if (!WIFEXITED(st) || WEXITSTATUS(st)) { printf("%-6s FAILED (%s %d)\n", CASES[i].name, WIFSIGNALED(st) ? "signal" : "status", WIFSIGNALED(st) ? WTERMSIG(st) : WEXITSTATUS(st)); bad++; }
+    }
+    printf(bad ? "[RED] %d layout(s) failed\n" : "all %d runtime layouts OK\n", bad ? bad : NCASES);
+    return bad ? 1 : 0;
+}
diff --git a/dm/host/tests/t_profile_runtime.c b/dm/host/tests/t_profile_runtime.c
new file mode 100644
index 00000000..bbf0e321
--- /dev/null
+++ b/dm/host/tests/t_profile_runtime.c
@@ -0,0 +1,100 @@
+// The runtime profile (hle_profile.c): a DM_PROFILE file whose values differ from the compiled game_profile.h reaches dm_profile(),
+// and without DM_PROFILE the compiled values come back. One process per case (the profile loads once), the test re-execs itself.
+// Build: clang -O1 -I.. -I../gen/<game> -o build/t_profile_runtime t_profile_runtime.c ../hle_profile.c
+#include "../dm.h"
+#include "../hle_profile.h"
+#include <assert.h>
+#include <errno.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+struct dm_flags g_flag;
+
+#define CHECK(c) do { if (!(c)) { printf("[RED] %s:%d: %s\n", __FILE__, __LINE__, #c); return 1; } } while (0)
+
+static int child_file(const char *path) {
+    setenv("DM_PROFILE", path, 1);
+    const struct dm_profile *p = dm_profile();
+    CHECK(p == dm_prof());
+    CHECK(!strcmp(p->id, "0100000000001234") && !strcmp(p->name, "Runtime Test"));
+    CHECK(p->program_id == 0x0100000000001234ull);
+    CHECK(p->nmod == 3 && !strcmp(p->modules[0], "main") && !strcmp(p->modules[1], "subsdk0") && !strcmp(p->modules[2], "sdk"));
+    CHECK(!strcmp(p->args, "-foo=1 -bar"));
+    CHECK(p->stdalloc_cap == 0x180000000ull);
+    CHECK(p->shader_skip_off == 0x770 && p->shader_skip_len == 0x78);
+    CHECK(p->tex_bc_cpu == 1 && p->ue_texture_pool == 1000 && p->enc_thread == 1 && p->draw_barriers_game == 1 && p->core_preempt == 1 && p->fps_target == 30);
+    CHECK(p->shared_font_ttf == 1 && p->nvn_api_major == 55 && p->nvn_api_minor == 12);
+    CHECK(p->nver == 1 && !strcmp(p->ver[0].build, "abcd") && !strcmp(p->ver[0].ver, "2.0.1"));
+    return 0;
+}
+// the "none" spellings game.py writes for a game that leaves a key out: they must undo the compiled game's value
+static int child_none(const char *path) {
+    setenv("DM_PROFILE", path, 1);
+    const struct dm_profile *p = dm_profile();
+    CHECK(p->shader_skip_len == 0 && p->shared_font_ttf == -1 && p->nvn_api_major == 0 && p->stdalloc_cap == 0);
+    CHECK(p->tex_bc_cpu == 0 && p->ue_texture_pool == 0 && p->enc_thread == 0 && p->draw_barriers_game == 0);
+    return 0;
+}
+static int child_env(void) {   // DM_PROF_<KEY> wins over the file and over the compiled profile
+    unsetenv("DM_PROFILE");
+    setenv("DM_PROF_STDALLOC_CAP", "0x40000000", 1); setenv("DM_PROF_SHADER_KEY_SKIP", "0x30+0x10", 1); setenv("DM_PROF_ENC_THREAD", "1", 1);
+    const struct dm_profile *p = dm_profile();
+    CHECK(p->stdalloc_cap == 0x40000000ull && p->shader_skip_off == 0x30 && p->shader_skip_len == 0x10 && p->enc_thread == 1);
+    return 0;
+}
+static int child_compiled(void) {   // no DM_PROFILE: exactly the header
+    unsetenv("DM_PROFILE");
+    const struct dm_profile *p = dm_profile();
+    static const char *m[] = DM_GAME_MODULES;
+    CHECK(!strcmp(p->id, DM_GAME_ID) && !strcmp(p->name, DM_GAME_NAME) && p->program_id == DM_GAME_PROGRAM_ID);
+    CHECK(p->nmod == DM_GAME_NMOD);
+    for (int i = 0; i < p->nmod; i++) CHECK(!strcmp(p->modules[i], m[i]));
+    CHECK(!strcmp(p->args, DM_GAME_ARGS));
+    CHECK(p->stdalloc_cap == DM_GAME_STDALLOC_CAP);
+    CHECK(p->shader_skip_off == DM_GAME_SHADER_KEY_SKIP_OFF && p->shader_skip_len == DM_GAME_SHADER_KEY_SKIP_LEN);
+    CHECK(p->tex_bc_cpu == DM_GAME_TEX_BC_CPU && p->ue_texture_pool == DM_GAME_UE_TEXTURE_POOL && p->enc_thread == DM_GAME_ENC_THREAD && p->draw_barriers_game == DM_GAME_DRAW_BARRIERS_GAME);
+    CHECK(p->core_preempt == DM_GAME_CORE_PREEMPT && p->fps_target == DM_GAME_FPS_TARGET);
+#ifdef DM_GAME_NVN_API_MAJOR
+    CHECK(p->nvn_api_major == DM_GAME_NVN_API_MAJOR && p->nvn_api_minor == DM_GAME_NVN_API_MINOR);
+#else
+    CHECK(p->nvn_api_major == 0);
+#endif
+#ifdef DM_GAME_SHARED_FONT_TTF
+    CHECK(p->shared_font_ttf == DM_GAME_SHARED_FONT_TTF);
+#else
+    CHECK(p->shared_font_ttf == -1);
+#endif
+    return 0;
+}
+
+static int write_file(const char *path, const char *body) {
+    FILE *f = fopen(path, "w");
+    if (!f) { printf("[RED] cannot write %s (errno %d)\n", path, errno); return 1; }
+    fputs(body, f); fclose(f); return 0;
+}
+
+int main(int argc, char **argv) {
+    if (argc > 2 && !strcmp(argv[1], "file")) return child_file(argv[2]);
+    if (argc > 2 && !strcmp(argv[1], "none")) return child_none(argv[2]);
+    if (argc > 1 && !strcmp(argv[1], "env")) return child_env();
+    if (argc > 1 && !strcmp(argv[1], "compiled")) return child_compiled();
+    char dir[256]; snprintf(dir, sizeof dir, "%s/t_profile_runtime.XXXXXX", getenv("TMPDIR") ?: "/tmp");
+    if (!mkdtemp(dir)) { printf("[RED] mkdtemp failed\n"); return 1; }
+    char full[300], none[300]; snprintf(full, sizeof full, "%s/full.tsv", dir); snprintf(none, sizeof none, "%s/none.tsv", dir);
+    if (write_file(full, "# values that differ from any compiled profile\n"
+            "title_id\t0100000000001234\nprogram_id\t0x0100000000001234\nname\tRuntime Test\nmodules\tmain subsdk0 sdk\ngame_args\t-foo=1 -bar\n"
+            "stdalloc_cap\t0x180000000\nshader_key_skip\t0x770+0x78\ntex_bc_cpu\t1\nue_texture_pool\t1000\nenc_thread\t1\ndraw_barriers\tgame\ncore_preempt\t1\nfps_target\t30\n"
+            "shared_font\tttf\ndevice_api\t55.12\nbuild\tabcd\t2.0.1\tdisplay\n")) return 1;
+    if (write_file(none, "shader_key_skip\t0x0+0x0\nshared_font\tauto\ndevice_api\t0.0\nstdalloc_cap\t0x0\ntex_bc_cpu\t0\nue_texture_pool\t0\nenc_thread\t0\ndraw_barriers\t0\n")) return 1;
+    const char *cases[][2] = {{"file", full}, {"none", none}, {"env", NULL}, {"compiled", NULL}};
+    int bad = 0;
+    for (int i = 0; i < 4; i++) {
+        pid_t pid = fork();
+        if (!pid) { execl(argv[0], argv[0], cases[i][0], cases[i][1], (char *)NULL); _exit(3); }
+        int st = 0; waitpid(pid, &st, 0);
+        if (!WIFEXITED(st) || WEXITSTATUS(st)) { printf("%-8s FAILED\n", cases[i][0]); bad++; } else printf("%-8s OK\n", cases[i][0]);
+    }
+    unlink(full); unlink(none); rmdir(dir);
+    printf(bad ? "[RED] %d profile case(s) failed\n" : "runtime profile OK\n", bad);
+    return bad ? 1 : 0;
+}
