-// A path quoted for the shell (single quotes; a quote inside becomes '\'')
-static NSString *shell_quote(NSString *p) { return [NSString stringWithFormat:@"'%@'", [p stringByReplacingOccurrencesOfString:@"'" withString:@"'\\''"]]; }
